#!/usr/bin/env python3
"""muster: plan -> build -> verify for one spec, with a separate agent per role, on herdr.

  muster herd <spec dir>          start a herd from an agent's terminal: that agent joins the herd's
                                  space and gets the outcome as a message
  muster start <spec dir>         start a herd now, with no origin agent
  muster pr <url | owner/repo#N | N>
                                  watch a pull request: Tinker fixes failed checks and addresses review
                                  comments, Nitpick checks each fix, then Tinker pushes and replies;
                                  the calling agent joins the PR's space and gets the outcome
  muster resume <dir>             resume an escalated herd or PR watch
  muster install [--on MACHINE]   install/refresh on this machine (or an hc machine)
  muster doctor                   check this machine's setup
  muster watch                    daemon: start a herd for every spec whose Status is the trigger (Herd)
  muster run <spec dir>           Herder itself (a hidden hc terminal); run-pr <dir> for a PR watch

Config: ~/.config/muster/config.toml (agent command per role, spec roots, trigger word).
Roles: Plotter plans, Tinker builds, Nitpick verifies; Herder (this script) drives the gates.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import uuid
from pathlib import Path

HOME = Path.home()
CFG_DIR = HOME / ".config" / "muster"
CFG_FILE = CFG_DIR / "config.toml"
SHARE = HOME / ".local" / "share" / "muster"
BIN = HOME / ".local" / "bin" / "muster"
TEMPLATES = HOME / ".config" / "herdr-core" / "templates"
SKILLS = HOME / ".agents" / "skills"
HERDR_MODS = HOME / ".config" / "herdr-app" / "mods"
REPO = Path(__file__).resolve().parent.parent

ROLES = ("plotter", "tinker", "nitpick")
TITLES = {"herder": "Herder", "plotter": "Plotter", "tinker": "Tinker", "nitpick": "Nitpick"}
BLURB = {"plotter": "reviews the draft PLAN.md (or writes one) and finalizes it", "tinker": "builds the FINAL plan",
         "nitpick": "verifies independently and signs off"}
# Agents known to report status to herdr (OSC 7501); others get `ready: quiet`.
REPORTING = {"omp", "claude", "codex", "pi", "opencode", "amp", "droid", "gemini", "kimi", "qwen", "cursor-agent", "devin"}
DOC = "herdr-app"
GRID = [["origin", "plotter"], ["tinker", "nitpick"]]  # origin: the agent that ran `muster herd`

DEFAULT_CONFIG = """# Muster config. Each role runs an interactive agent command of your choice.
spec_roots = ["~/code/specs"]   # each spec: <root>/<folder>/spec.md (or SPEC.md)
trigger = "Herd"                # a spec's Status value that starts a herd
# editor = "nvim"               # opens a spec from its pane header; default: $VISUAL/$EDITOR, else nvim/hx/vim/nano/vi

[roles.plotter]
command = "omp"
# ready = "quiet"               # only for agents that don't report status to herdr

[roles.tinker]
command = "omp"

[roles.nitpick]
command = "omp"                 # e.g. "codex --model gpt-5" to have another model check the work
"""


# ---------- config (tiny TOML subset: [tables], key = "str" | number | ["str", ...]) ----------

def parse_toml(text: str) -> dict:
    try:
        import tomllib  # Python 3.11+
        return tomllib.loads(text)
    except ImportError:
        pass
    data: dict = {}
    cur = data
    for raw in text.splitlines():
        line = re.sub(r"\s+#.*$", "", raw).strip()
        if not line or line.startswith("#"):
            continue
        m = re.fullmatch(r"\[([A-Za-z0-9_.-]+)\]", line)
        if m:
            cur = data
            for part in m.group(1).split("."):
                cur = cur.setdefault(part, {})
            continue
        key, _, val = line.partition("=")
        cur[key.strip()] = json.loads(val.strip())
    return data


def config() -> dict:
    cfg = parse_toml(CFG_FILE.read_text()) if CFG_FILE.is_file() else parse_toml(DEFAULT_CONFIG)
    cfg.setdefault("spec_roots", ["~/code/specs"])
    cfg.setdefault("trigger", "Herd")
    roles = cfg.setdefault("roles", {})
    for r in ROLES:
        roles.setdefault(r, {}).setdefault("command", "omp")
    return cfg


def agent_name(command: str) -> str:
    return Path(shlex.split(command)[0]).name


def agent_command(command: str, writable: list[Path]) -> str:
    """Per-agent adjustments so an agent can run unattended under hc. `writable`: the spec roots, which
    sit outside the repo the agent starts in but must be writable (PLAN.md, IMPL.md, VERDICT.md)."""
    name = agent_name(command)
    args = set(shlex.split(command))
    dirs = "".join(f" --add-dir {shlex.quote(str(p))}" for p in writable)
    if name == "omp":
        command += f" --config {shlex.quote(str(CFG_DIR / 'omp' / 'overlay.yml'))} -e {shlex.quote(str(CFG_DIR / 'omp' / 'title.ts'))}"
    elif name == "claude":
        command += dirs
    elif name == "codex":
        if "--no-daemon" not in args:
            command += " --no-daemon"  # hc requirement: otherwise codex runs commands outside the terminal
        if not args & {"--sandbox", "-s", "--ask-for-approval", "-a", "--yolo", "--dangerously-bypass-approvals-and-sandbox"}:
            # Started plainly, codex is read-only and ignores --add-dir.
            command += " --sandbox workspace-write --ask-for-approval never -c sandbox_workspace_write.network_access=true"
        command += dirs
    return command


def role_prompt(role: str) -> str:
    override = CFG_DIR / "roles" / f"{role}.md"
    return (override if override.is_file() else SHARE / "roles" / f"{role}.md").read_text()


# ---------- spec files ----------

FIELD_RE = r"^(?P<pre>[ \t]*(?:\|[ \t]*)?\*{{0,2}}{key}\*{{0,2}}[ \t]*(?::\*{{0,2}}|\|)[ \t]*)(?P<val>[^|\n]*?)(?P<post>[ \t]*(?:\|[^\n]*)?)$"
STATUS_RE = re.compile(FIELD_RE.format(key="Status"), re.M | re.I)
REPOS_RE = re.compile(FIELD_RE.format(key="Repos?"), re.M | re.I)


def spec_roots(cfg: dict) -> list[Path]:
    env = os.environ.get("MUSTER_SPEC_ROOTS")
    roots = env.split(":") if env else cfg["spec_roots"]
    return [Path(p).expanduser() for p in roots if p]


def spec_file(d: Path) -> Path | None:
    for name in ("spec.md", "SPEC.md", "PR.md"):
        if (d / name).is_file():
            return d / name
    return None


def get_status(text: str) -> str | None:
    m = STATUS_RE.search(text)
    return m.group("val").strip() if m else None


def set_status(path: Path, value: str) -> None:
    text = path.read_text()
    m = STATUS_RE.search(text)
    if m:
        path.write_text(text[: m.start("val")] + value + text[m.end("val") :])


def herd_id(d: Path) -> str:
    s = re.sub(r"[^a-z0-9-]+", "-", d.name.lower()).strip("-")
    return s[:24].strip("-") or "spec"


def space_id(d: Path) -> str:
    return "spmuster" + hashlib.sha1(str(d).encode()).hexdigest()[:20]


def tab_id(d: Path) -> str:
    return "tbmuster" + hashlib.sha1(str(d).encode()).hexdigest()[:20]


def resolve_repos(text: str, code_root: Path) -> list[Path]:
    m = REPOS_RE.search(text)
    found: list[Path] = []
    for item in (m.group("val").split(",") if m else []):
        item = item.strip().strip("`")
        if not item:
            continue
        if item[0] in "/~":
            cand = Path(item.split()[0]).expanduser()
        else:
            name = re.match(r"[A-Za-z0-9._-]+", item)
            if not name:
                continue
            cand = code_root / name.group(0)
        if (cand / ".git").exists() and cand not in found:
            found.append(cand)
    return found


# ---------- hc ----------

def hc(*args: str, check: bool = True) -> dict:
    p = subprocess.run(["hc", args[0], "--json", *args[1:]], capture_output=True, text=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"hc {args[0]} failed: {p.stderr.strip() or p.stdout.strip()}")
    try:
        return json.loads(p.stdout) if p.stdout.strip() else {}
    except json.JSONDecodeError:
        return {}


def rpc(method: str, params: dict) -> dict:
    msgs = [{"jsonrpc": "2.0", "id": 0, "method": "hello", "params": {}},
            {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}]
    p = subprocess.run(["hc", "connect"], input="\n".join(map(json.dumps, msgs)) + "\n",
                       capture_output=True, text=True, timeout=30)
    for line in p.stdout.splitlines():
        o = json.loads(line)
        if o.get("id") == 1:
            return o
    raise RuntimeError(f"hc connect gave no reply: {p.stderr.strip()}")


def live_terminals(**labels: str) -> list[dict]:
    return [t for t in hc("ls").get("terminals", []) if t.get("state") == "live"
            and all((t.get("labels") or {}).get(k) == v for k, v in labels.items())]


# ---------- Herdr layout: the tab lives in herdr-core's `herdr-app` doc, so it works without a window ----------

def _prune(node: dict | None, gone: set[str]) -> dict | None:
    """Drop blocks showing any terminal in `gone`; containers left empty disappear."""
    if not node:
        return None
    if node.get("type") == "block":
        return None if (node.get("content") or {}).get("terminal") in gone else node
    kids = [k for k in (_prune(c, gone) for c in node.get("children") or []) if k]
    return {**node, "children": kids} if kids else None


def _blocks(node: dict | None, acc: dict[str, str]) -> dict[str, str]:
    if node:
        if node.get("type") == "block" and (node.get("content") or {}).get("terminal"):
            acc[node["content"]["terminal"]] = node["id"]
        for c in node.get("children") or []:
            _blocks(c, acc)
    return acc


def write_layout(d: Path, folder: str, members: dict[str, str] | None, grid: list[list[str]] = GRID) -> None:
    """Give the herd its own space (named after the spec folder) with one tab holding a grid of
    members (slot -> address). A member shown in another tab (the origin agent's pane) moves here;
    a tab or space that move leaves empty closes. members=None removes the herd's space."""
    sid, tid = space_id(d), tab_id(d)
    for _ in range(10):
        got = rpc("doc.get", {"name": DOC})["result"]
        doc, version = got.get("value") or {}, got.get("version", 0)
        spaces = doc.setdefault("spaces", [])
        space = next((s for s in spaces if s.get("id") == sid), None)
        if members is None:
            if not space:
                return
            spaces.remove(space)
        else:
            moving = set(members.values())
            for other in list(spaces):
                if other is space:
                    continue
                for t in list(other.get("tabs", [])):
                    if moving & set(_blocks(t.get("root"), {})):
                        t["root"] = _prune(t.get("root"), moving)
                        if not t["root"]:
                            other["tabs"].remove(t)
                if not other.get("tabs"):
                    spaces.remove(other)
            if not space:
                space = {"id": sid, "name": d.name, "folder": folder, "tabs": []}
                spaces.append(space)
            tab = next((t for t in space.get("tabs", []) if t.get("id") == tid), None)
            if not tab:
                tab = {"id": tid, "name": "herd"}
                space.setdefault("tabs", []).append(tab)
            panes = _blocks(tab.get("root"), {})
            rows = []
            for i, row in enumerate(grid):
                cells = [r for r in row if r in members]
                if cells:
                    rows.append({"type": "row", "id": f"{tid}r{i}", "size": {"weight": 1.0}, "children": [
                        {"type": "block", "id": panes.get(members[r]) or "p" + uuid.uuid4().hex,
                         "content": {"terminal": members[r]}, "size": {"weight": 1.0}} for r in cells]})
            space["name"] = d.name
            tab["root"] = {"type": "column", "id": tid, "children": rows}
        if "result" in rpc("doc.set", {"name": DOC, "value": doc, "version": version}):
            return
        time.sleep(0.3)  # the app wrote at the same time: re-read and retry
    raise RuntimeError("could not write the Herdr layout (doc kept changing)")


def editor_argv() -> list[str]:
    """The editor that opens a spec from its pane header: config `editor`, else a real $VISUAL/$EDITOR,
    else the first terminal editor installed."""
    for cmd in (config().get("editor"), os.environ.get("VISUAL"), os.environ.get("EDITOR")):
        if cmd and agent_name(cmd) not in ("true", "false", ":") and shutil.which(agent_name(cmd)):
            return shlex.split(cmd)
    return [next((e for e in ("nvim", "hx", "vim", "nano", "vi") if shutil.which(e)), "vi")]


def spec_labels(d: Path) -> list[str]:
    """Labels that give a pane header its spec link (muster-pane mod)."""
    sf = spec_file(d)
    out = [f"muster.spec={d}"]
    return out + [f"muster.specfile={sf}", f"muster.editor={json.dumps(editor_argv())}"] if sf else out


def labels(d: Path, role: str, shown: bool = True) -> list[str]:
    """hc --label args. shown=False leaves out herdr.space/herdr.tab so Herdr keeps it off screen."""
    kvs = [*spec_labels(d), f"muster.role={role}"]
    if shown:
        kvs = [f"herdr.space={space_id(d)}", f"herdr.tab={tab_id(d)}", *kvs]
    out: list[str] = []
    for kv in kvs:
        out += ["--label", kv]
    return out


def core_id() -> str:
    return (hc("server", "status").get("core") or {}).get("id", "")


# ---------- start / watch ----------

def start(d: Path) -> str:
    d = d.expanduser().resolve()
    if not spec_file(d):
        raise RuntimeError(f"no spec.md or SPEC.md in {d}")
    if live_terminals(**{"muster.spec": str(d), "muster.role": "herder"}):
        return "already running"
    me = shutil.which("muster") or str(Path(__file__).resolve())
    out = hc("run", "--bg", "--no-parent", "--name", f"{herd_id(d)}-herder", "--cwd", str(d),
             *labels(d, "herder", shown=False), "--", sys.executable, me, "run", str(d))
    return out.get("address", "?")


def herd(d: Path) -> str:
    """Start a herd now, from an agent's terminal: that terminal becomes the herd's origin. Its pane
    moves into the herd's space and it gets the outcome as a message."""
    d = d.expanduser().resolve()
    sf = spec_file(d)
    if not sf:
        raise RuntimeError(f"no spec.md or SPEC.md in {d}")
    origin = d / ".muster-origin.json"
    me = os.environ.get("HC_TERMINAL_ID")
    if me:
        origin.write_text(json.dumps({"terminal": me, "core": core_id()}) + "\n")
    elif origin.exists():
        origin.unlink()
    set_status(sf, "In progress (muster)")
    return start(d)


def watch(interval: float = 5.0) -> None:
    cfg = config()
    trigger = cfg["trigger"].lower()
    print(f"muster watch: roots {', '.join(map(str, spec_roots(cfg)))}; trigger Status: {cfg['trigger']}", flush=True)
    seen: dict[Path, float] = {}
    while True:
        for root in spec_roots(cfg):
            for d in sorted(p for p in root.iterdir() if p.is_dir()) if root.is_dir() else []:
                sf = spec_file(d)
                if not sf or seen.get(sf) == sf.stat().st_mtime:
                    continue
                seen[sf] = sf.stat().st_mtime
                if (get_status(sf.read_text()) or "").lower() != trigger:
                    continue
                stamp = time.strftime("%Y-%m-%d %H:%M:%S")
                try:
                    set_status(sf, "In progress (muster)")
                    print(f"{stamp} start {d}: {start(d)}", flush=True)
                except Exception as e:  # noqa: BLE001 - surface any launch failure in the spec itself
                    set_status(sf, f"Muster failed: {str(e)[:120]}")
                    print(f"{stamp} FAILED {d}: {e}", flush=True)
                seen[sf] = sf.stat().st_mtime
        time.sleep(interval)


# ---------- Herder ----------

class Herder:
    """Drives one herd. Runs hidden (no pane); its pane slot goes to the origin agent, if any."""

    GRID = GRID
    TEMPLATE = "muster-{role}"

    def __init__(self, d: Path):
        self.d = d.resolve()
        self.sf = spec_file(self.d)
        self.id = herd_id(self.d)
        self.me = os.environ.get("HC_TERMINAL_ID", "")
        self.repos = resolve_repos(self.sf.read_text(), self.d.parent.parent) if self.sf else []
        self.cwd = self.repos[0] if self.repos else self.d.parent.parent
        self.log_path = self.d / "muster.log"
        self.members: dict[str, str] = {}
        self.origin = self.find_origin()
        if self.origin:
            self.members["origin"] = self.origin

    def find_origin(self) -> str | None:
        p = self.d / ".muster-origin.json"
        try:
            o = json.loads(p.read_text())
        except (OSError, json.JSONDecodeError):
            return None
        term = o.get("terminal")
        if not term or o.get("core") != core_id():  # a terminal on another machine can't join this space
            return None
        live = hc("get", term, check=False)
        return term if live.get("state") == "live" else None

    def log(self, msg: str) -> None:
        line = f"{time.strftime('%H:%M:%S')}  {msg}"
        print(line, flush=True)
        with self.log_path.open("a") as f:
            f.write(line + "\n")

    def tell_origin(self, text: str) -> None:
        if not self.origin:
            return
        r = subprocess.run(["hc", "send", self.origin, text], capture_output=True, text=True)
        self.log(f"-> origin {self.origin}: {text[:200]}" + (f"  !! {r.stderr.strip()}" if r.returncode else ""))

    def layout(self, remove: bool = False) -> None:
        try:
            write_layout(self.d, str(self.cwd), None if remove else self.members, self.GRID)
        except Exception as e:  # noqa: BLE001 - layout is cosmetic; never stop the pipeline for it
            self.log(f"layout: {e}")

    def name(self, role: str) -> str:
        return f"{self.id}-{role}"

    def launch(self, role: str, task: str) -> None:
        out = hc("run", "--bg", "--name", self.name(role), "--cwd", str(self.cwd), *labels(self.d, role),
                 self.TEMPLATE.format(role=role), task, check=False)
        addr = out.get("address")
        if not addr:
            self.log(f"!! could not start {TITLES[role]}: {out}")
            self.tell_origin(f"Muster: {self.d.name} is stuck: {TITLES[role]} could not start. See {self.log_path}.")
            return
        self.members[role] = addr
        sent = (out.get("first_message") or {}).get("sent")
        self.log(f"started {TITLES[role]} as {addr}" + ("" if sent else "  !! task NOT delivered; check its pane"))
        self.layout()

    def first_line(self, fname: str) -> str:
        p = self.d / fname
        text = p.read_text().strip() if p.is_file() else ""
        return text.splitlines()[0].strip() if text else ""

    def set_spec_status(self, value: str) -> None:
        if self.sf:
            set_status(self.sf, value)

    def stop_peers(self) -> None:
        for role in ("nitpick", "tinker", "plotter"):
            if role in self.members:
                subprocess.run(["hc", "kill", self.name(role)], capture_output=True)
                subprocess.run(["hc", "rm", self.name(role)], capture_output=True)
                del self.members[role]

    def close(self) -> None:
        """Leave the origin agent alone in the herd's space, or remove the space if there is none."""
        self.stop_peers()
        self.layout(remove=not self.origin)

    def run(self) -> None:
        repos = ", ".join(map(str, self.repos)) or "not resolved from the spec's Repos row; find the checkouts (usually under ~/code)"
        common = f"Spec dir: {self.d}. Herder: {self.me}. Repos: {repos}."
        self.log(f"herd {self.id}: spec {self.sf}")
        self.log(f"repos: {repos}; origin: {self.origin or 'none'}")
        if self.origin:
            subprocess.run(["hc", "label", self.origin, f"herdr.space={space_id(self.d)}", f"herdr.tab={tab_id(self.d)}",
                            *spec_labels(self.d)], capture_output=True)
        draft = (self.d / "PLAN.md").is_file()
        self.log(f"plan: {'draft PLAN.md found; Plotter reviews it' if draft else 'no draft; Plotter writes PLAN.md'}")
        self.launch("plotter", f"{common} " + ("A draft PLAN.md is waiting: review it, don't re-plan. " if draft else "There is no draft PLAN.md: write it. ")
                    + f"Tinker will be {self.name('tinker')}.")
        escalated = False
        for raw in sys.stdin:
            line = raw.strip()
            if not line:
                if escalated:
                    escalated = False
                    self.set_spec_status("In progress (muster)")
                    self.log("resumed")
                continue
            self.log(f"<- {line[:300]}")
            if "PLAN_FINAL" in line and "tinker" not in self.members:
                if self.first_line("PLAN.md") != "Status: FINAL":
                    self.log("!! PLAN_FINAL but PLAN.md is not Status: FINAL; waiting")
                    continue
                self.launch("tinker", f"{common} Plotter: {self.name('plotter')}. Nitpick will be {self.name('nitpick')}.")
            elif "IMPL_DONE" in line and "nitpick" not in self.members:
                self.launch("nitpick", f"{common} Tinker: {self.name('tinker')}. Plotter: {self.name('plotter')}.")
            elif "SIGNED_OFF" in line:
                verdict = self.first_line("VERDICT.md")
                if verdict != "Verdict: SIGNED-OFF":
                    self.log(f"!! SIGNED_OFF but VERDICT.md says {verdict!r}; waiting")
                    continue
                self.set_spec_status("Implemented (muster signed off; see VERDICT.md)")
                self.log("SIGNED OFF")
                self.close()
                self.tell_origin(f"Muster: {self.d.name} is SIGNED OFF. Verdict: {self.d}/VERDICT.md; plan: {self.d}/PLAN.md; "
                                 f"build notes: {self.d}/IMPL.md. The spec's Status is now Implemented.")
                return
            elif "ESCALATE" in line:
                escalated = True
                self.set_spec_status("In progress (muster escalated; see VERDICT.md)")
                self.log("ESCALATED")
                self.tell_origin(f"Muster: {self.d.name} ESCALATED: Nitpick still rejects after 3 rounds, see {self.d}/VERDICT.md. "
                                 f"Plotter, Tinker and Nitpick stay up in this space. Once it's sorted: muster resume {self.d}")


def run(d: Path) -> None:
    herder = Herder(d)
    try:
        herder.run()
    except Exception as e:  # noqa: BLE001 - surface any crash in the spec and to the origin agent
        herder.set_spec_status(f"Muster failed: {str(e)[:120]}")
        herder.log(f"!! Herder crashed: {e!r}")
        herder.close()
        herder.tell_origin(f"Muster: {herder.d.name} FAILED: {e}. See {herder.log_path}.")


def resume(d: Path) -> str:
    d = d.expanduser().resolve()
    t = live_terminals(**{"muster.spec": str(d), "muster.role": "herder"})
    if not t:
        raise RuntimeError(f"no running herd for {d}")
    hc("keys", t[0]["address"], "enter")
    return "resumed"


# ---------- PR mode: watch a pull request, fix failures, address review comments ----------

PR_GRID = [["origin", "tinker"], ["nitpick"]]
FAILED = {"failure", "timed_out", "startup_failure", "action_required", "error"}
PENDING = {"queued", "in_progress", "waiting", "pending", "requested"}


def gh(*args: str) -> object:
    p = subprocess.run(["gh", *args], capture_output=True, text=True)
    if p.returncode != 0:
        raise RuntimeError(f"gh {' '.join(args[:3])} failed: {p.stderr.strip()[:300]}")
    return json.loads(p.stdout) if p.stdout.strip() else None


def git(cwd: Path, *args: str) -> str:
    p = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    if p.returncode != 0:
        raise RuntimeError(f"git {' '.join(args[:2])} failed in {cwd}: {p.stderr.strip()[:300]}")
    return p.stdout.strip()


def parse_pr(ref: str, cwd: Path) -> tuple[str, int]:
    """`https://github.com/o/r/pull/12`, `o/r#12`, or `12` (repo from the current checkout)."""
    m = re.search(r"github\.com/([^/]+/[^/]+)/pull/(\d+)", ref) or re.fullmatch(r"([\w.-]+/[\w.-]+)#(\d+)", ref)
    if m:
        return m.group(1), int(m.group(2))
    if ref.isdigit():
        repo = subprocess.run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
                              cwd=cwd, capture_output=True, text=True).stdout.strip()
        if repo:
            return repo, int(ref)
    raise RuntimeError(f"can't read PR {ref!r}: use its URL, owner/repo#N, or a number inside the repo's checkout")


def pr_checkout(repo: str, number: int, branch: str, code_root: Path) -> Path:
    """A checkout of the PR's branch: wherever it's already checked out, else a new worktree."""
    name = repo.split("/")[1]
    clones = [p for p in (Path.cwd(), code_root / name) if (p / ".git").exists()]
    clone = next((p for p in clones if repo.lower() in git(p, "remote", "get-url", "origin").lower()), None)
    if not clone:
        raise RuntimeError(f"no local clone of {repo} (looked in {', '.join(map(str, [Path.cwd(), code_root / name]))})")
    current = None
    for block in git(clone, "worktree", "list", "--porcelain").split("\n\n"):
        if f"branch refs/heads/{branch}" in block.splitlines():
            current = Path(block.splitlines()[0].split(" ", 1)[1])
    if current:
        return current
    git(clone, "fetch", "origin", branch)
    wt = code_root / ".muster-worktrees" / f"{name}-pr{number}"
    has_local = subprocess.run(["git", "-C", str(clone), "rev-parse", "--verify", "-q", f"refs/heads/{branch}"],
                               capture_output=True).returncode == 0
    if has_local:
        git(clone, "worktree", "add", str(wt), branch)
    else:
        git(clone, "worktree", "add", "--track", "-b", branch, str(wt), f"origin/{branch}")
    return wt


def pr_start(ref: str) -> str:
    """`muster pr <ref>` from an agent's terminal: that agent joins the PR's space and gets the outcome."""
    root = spec_roots(config())[0]
    repo, number = parse_pr(ref, Path.cwd())
    info = gh("pr", "view", str(number), "-R", repo, "--json", "number,title,url,headRefName,baseRefName,isCrossRepository,state")
    if info["state"] != "OPEN":
        raise RuntimeError(f"{info['url']} is {info['state'].lower()}")
    if info["isCrossRepository"]:
        raise RuntimeError(f"{info['url']} comes from a fork; Muster can only push to branches in {repo}")
    checkout = pr_checkout(repo, number, info["headRefName"], root.parent)
    d = (root / "prs" / f"{repo.split('/')[1]}-pr{number}").resolve()
    d.mkdir(parents=True, exist_ok=True)
    meta = {"repo": repo, "number": number, "url": info["url"], "title": info["title"],
            "branch": info["headRefName"], "base": info["baseRefName"], "checkout": str(checkout)}
    (d / ".muster-pr.json").write_text(json.dumps(meta, indent=2) + "\n")
    if not (d / "PR.md").exists():
        (d / "PR.md").write_text(f"# {info['title']}\n\n| | |\n|---|---|\n| **PR** | {info['url']} |\n"
                                 f"| **Branch** | {info['headRefName']} → {info['baseRefName']} |\n"
                                 f"| **Checkout** | {checkout} |\n| **Status** | Watching (muster) |\n\n## Rounds\n")
    me = os.environ.get("HC_TERMINAL_ID")
    origin = d / ".muster-origin.json"
    if me:
        origin.write_text(json.dumps({"terminal": me, "core": core_id()}) + "\n")
    elif origin.exists():
        origin.unlink()
    if live_terminals(**{"muster.spec": str(d), "muster.role": "herder"}):
        return "already watching"
    prog = shutil.which("muster") or str(Path(__file__).resolve())
    out = hc("run", "--bg", "--no-parent", "--name", f"{herd_id(d)}-herder", "--cwd", str(d),
             *labels(d, "herder", shown=False), "--", sys.executable, prog, "run-pr", str(d))
    return f"watching {info['url']} ({out.get('address', '?')}); checkout {checkout}; notes {d}"


class PrHerder(Herder):
    """Watches one PR. Each round hands new feedback (failed checks, new or edited comments and reviews)
    to Tinker; Nitpick checks every fix before Tinker pushes and replies. Stops when green and quiet."""

    GRID = PR_GRID
    TEMPLATE = "muster-pr-{role}"

    def __init__(self, d: Path):
        super().__init__(d)
        self.meta = json.loads((self.d / ".muster-pr.json").read_text())
        self.repo, self.number = self.meta["repo"], self.meta["number"]
        self.cwd = Path(self.meta["checkout"])
        self.state_path = self.d / ".muster-pr-state.json"
        st = json.loads(self.state_path.read_text()) if self.state_path.is_file() else {}
        self.handled: set[str] = set(st.get("handled", []))
        self.round: int = st.get("round", 0)
        self.in_round = False
        self.round_items: list[str] = []
        self.needs_you: list[str] = st.get("needs_you", [])
        cfg = config()
        self.poll = float(cfg.get("pr_poll", 90))
        self.max_rounds = int(cfg.get("pr_max_rounds", 10))
        self.me_login = (gh("api", "user") or {}).get("login", "")
        self.pending_since: float | None = None
        self.quiet_until = 0.0  # after a push, don't call it converged before the new head's checks register

    def save(self) -> None:
        self.state_path.write_text(json.dumps({"handled": sorted(self.handled), "round": self.round,
                                               "needs_you": self.needs_you}, indent=1) + "\n")

    def api(self, path: str) -> list | dict:
        return gh("api", f"repos/{self.repo}/{path}") or []

    def feedback(self, sha: str) -> tuple[list[tuple[str, str]], bool]:
        """New items as (key, markdown), and whether any check on the head is still running."""
        items: list[tuple[str, str]] = []
        for c in self.api(f"issues/{self.number}/comments?per_page=100"):
            if c["user"]["login"] != self.me_login:
                items.append((f"issue-comment:{c['id']}@{c['updated_at']}",
                              f"### Comment by {c['user']['login']} ({c['html_url']}, updated {c['updated_at']})\n\n{c['body']}"))
        for c in self.api(f"pulls/{self.number}/comments?per_page=100"):
            if c["user"]["login"] != self.me_login:
                where = f"{c.get('path')}:{c.get('line') or c.get('original_line') or '?'}"
                items.append((f"review-comment:{c['id']}@{c['updated_at']}",
                              f"### Inline comment by {c['user']['login']} on {where} (id {c['id']}, {c['html_url']})\n\n{c['body']}"))
        for r in self.api(f"pulls/{self.number}/reviews?per_page=100"):
            if r["user"]["login"] != self.me_login and (r.get("body") or r["state"] == "CHANGES_REQUESTED"):
                items.append((f"review:{r['id']}@{r.get('submitted_at')}",
                              f"### Review by {r['user']['login']}: {r['state']} ({r['html_url']})\n\n{r.get('body') or ''}"))
        running = False
        for c in self.api(f"commits/{sha}/check-runs?per_page=100").get("check_runs", []):
            if c["status"] in PENDING:
                running = True
            elif (c.get("conclusion") or "") in FAILED:
                notes = ""
                try:
                    ann = self.api(f"check-runs/{c['id']}/annotations")
                    notes = "\n".join(f"- {a.get('annotation_level')}: {a.get('title') or ''} {a.get('message', '')[:400]}" for a in ann[:20])
                except RuntimeError:
                    pass
                items.append((f"check:{sha}:{c['name']}",
                              f"### Check failed: {c['name']} ({c['conclusion']}, {c.get('html_url')})\n\n{notes or '(no annotations)'}"))
        for s in self.api(f"commits/{sha}/status").get("statuses", []):
            if s["state"] == "pending":
                running = True
            elif s["state"] in FAILED:
                items.append((f"status:{sha}:{s['context']}",
                              f"### Status failed: {s['context']} ({s['state']}, {s.get('target_url')})\n\n{s.get('description') or ''}"))
        return [(k, md) for k, md in items if k not in self.handled], running

    def note(self, text: str) -> None:
        with (self.d / "PR.md").open("a") as f:
            f.write(f"- {time.strftime('%Y-%m-%d %H:%M')} {text}\n")

    def start_round(self, sha: str, items: list[tuple[str, str]]) -> None:
        self.round += 1
        self.in_round = True
        self.round_items = [k for k, _ in items]
        path = self.d / f"round-{self.round}.md"
        path.write_text(f"# Round {self.round}: {self.meta['url']}\n\nHead: `{sha}` on `{self.meta['branch']}`; checkout `{self.cwd}`.\n\n"
                        + "\n\n".join(md for _, md in items) + "\n")
        self.log(f"round {self.round}: {len(items)} item(s) -> Tinker")
        self.note(f"round {self.round}: {len(items)} item(s), see round-{self.round}.md")
        subprocess.run(["hc", "send", self.name("tinker"), f"ROUND {self.round}: {path}"], capture_output=True)
        self.save()

    def end_round(self, how: str) -> None:
        self.handled.update(self.round_items)
        self.in_round = False
        self.round_items = []
        self.note(f"round {self.round}: {how}")
        self.save()

    def finish(self, outcome: str) -> None:
        set_status(self.d / "PR.md", f"{outcome} (muster)")
        self.note(outcome)
        self.log(outcome)
        self.close()
        extra = f" Needs you: {'; '.join(self.needs_you)}." if self.needs_you else ""
        self.tell_origin(f"Muster: {self.meta['url']} {outcome} after {self.round} round(s). Rounds and replies: {self.d}/PR.md.{extra}")

    def poll_once(self) -> bool:
        """Returns True when the watch is over."""
        pr = gh("pr", "view", str(self.number), "-R", self.repo, "--json", "state,headRefOid")
        if pr["state"] != "OPEN":
            self.finish(pr["state"].upper())
            return True
        if self.in_round:
            return False
        items, running = self.feedback(pr["headRefOid"])
        if running:  # wait for checks (and review bots, which run as checks) on the current head
            self.pending_since = self.pending_since or time.time()
            if time.time() - self.pending_since < 30 * 60:
                return False
        self.pending_since = None
        if items:
            if self.round >= self.max_rounds:
                self.tell_origin(f"Muster: {self.meta['url']} hit {self.max_rounds} rounds with feedback still coming; stopping here. See {self.d}/PR.md.")
                self.finish("STOPPED")
                return True
            self.start_round(pr["headRefOid"], items)
            return False
        if time.time() < self.quiet_until:
            return False
        self.finish("CONVERGED: green, no new feedback")
        return True

    def handle(self, line: str) -> None:
        if not line:
            if self.paused:
                self.paused = False
                self.log("resumed")
            return
        self.log(f"<- {line[:300]}")
        m = re.search(r"(PUSHED|NO_CHANGE|NEEDS_YOU|ESCALATE)\b[^:]*:?\s*(.*)", line)
        if not m:
            return
        kind, rest = m.group(1), m.group(2).replace("</hc>", "").strip()
        if kind == "NEEDS_YOU":
            self.needs_you.append(rest[:200])
            self.save()
            self.tell_origin(f"Muster: {self.meta['url']} round {self.round} needs you: {rest[:300]}")
        elif kind == "ESCALATE":
            self.paused = True
            self.tell_origin(f"Muster: {self.meta['url']} round {self.round} ESCALATED: Nitpick keeps rejecting Tinker's fix ({rest[:200]}). "
                             f"Tinker and Nitpick stay up in this space. Once it's sorted: muster resume {self.d}")
        elif self.in_round:
            if kind == "PUSHED":
                self.quiet_until = time.time() + 180
            self.end_round(f"pushed {rest[:60]}" if kind == "PUSHED" else "no code change")
            self.next_poll = time.time() + 30

    def run(self) -> None:
        import select
        self.log(f"watching {self.meta['url']} as {self.me_login or '?'}; checkout {self.cwd}; origin {self.origin or 'none'}")
        if self.origin:
            subprocess.run(["hc", "label", self.origin, f"herdr.space={space_id(self.d)}", f"herdr.tab={tab_id(self.d)}",
                            *spec_labels(self.d)], capture_output=True)
        common = (f"PR: {self.meta['url']} ({self.repo}#{self.number}), branch {self.meta['branch']} → {self.meta['base']}. "
                  f"Checkout: {self.cwd}. Notes dir D: {self.d}. Herder: {self.me}.")
        self.launch("tinker", f"{common} Nitpick: {self.name('nitpick')}. Wait for a ROUND message.")
        self.launch("nitpick", f"{common} Tinker: {self.name('tinker')}. Wait for a CHECK message from Tinker.")
        self.paused = False
        self.next_poll = time.time() + 20  # let both agents boot
        buf = b""
        while True:
            ready, _, _ = select.select([0], [], [], max(1.0, self.next_poll - time.time()))
            if ready:
                chunk = os.read(0, 65536)
                if not chunk:
                    return
                buf += chunk.replace(b"\r", b"\n")
                while b"\n" in buf:
                    raw, buf = buf.split(b"\n", 1)
                    self.handle(raw.decode(errors="replace").strip())
                continue
            if self.paused:
                self.next_poll = time.time() + self.poll
                continue
            try:
                if self.poll_once():
                    return
            except RuntimeError as e:  # a GitHub hiccup: log it and try again next poll
                self.log(f"poll: {e}")
            self.next_poll = time.time() + self.poll


def run_pr(d: Path) -> None:
    herder = PrHerder(d)
    try:
        herder.run()
    except Exception as e:  # noqa: BLE001 - surface any crash to the origin agent
        herder.log(f"!! PR herder crashed: {e!r}")
        herder.close()
        herder.tell_origin(f"Muster: {herder.meta.get('url', d.name)} watch FAILED: {e}. See {herder.log_path}.")


# ---------- install / doctor ----------

def write_templates(cfg: dict) -> None:
    TEMPLATES.mkdir(parents=True, exist_ok=True)
    # Spec herds: muster-<role>. PR watches: muster-pr-<role>, same agent command, PR-specific instructions.
    for role, prompt, name in [*((r, r, f"muster-{r}") for r in ROLES), *((r, f"pr-{r}", f"muster-pr-{r}") for r in ("tinker", "nitpick"))]:
        rc = cfg["roles"][role]
        cmd = agent_command(rc["command"], spec_roots(cfg))
        ready = rc.get("ready") or ("" if agent_name(rc["command"]) in REPORTING else "quiet")
        what = BLURB[role] if prompt == role else ("fixes PR failures and review comments" if role == "tinker" else "checks each PR fix before it's pushed")
        head = [f"description: Muster {TITLES[role]}: {what}. Started by Herder.",
                f"command: MUSTER_ROLE={TITLES[role]} {cmd}"]
        head += [f"ready: {ready}"] if ready else []
        head += [f"{k}: {rc[k]}" for k in ("submit", "stop", "paste_gap_ms") if k in rc]
        (TEMPLATES / f"{name}.md").write_text("---\n" + "\n".join(head) + "\n---\n" + role_prompt(prompt))


def install_service() -> str:
    py = sys.executable
    path = f"{HOME}/.local/bin:{HOME}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    if sys.platform == "darwin":
        label = "dev.herdr.muster"
        plist = HOME / "Library" / "LaunchAgents" / f"{label}.plist"
        log = HOME / "Library" / "Logs" / "muster.log"
        plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key><array><string>{py}</string><string>{BIN}</string><string>watch</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{path}</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{log}</string><key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
""")
        uid = os.getuid()
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
        subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(plist)], check=True)
        return f"launchd {label} (log {log})"
    unit = HOME / ".config" / "systemd" / "user" / "muster.service"
    unit.parent.mkdir(parents=True, exist_ok=True)
    unit.write_text(f"""[Unit]
Description=Muster: start the plan/build/verify herd for specs marked with the trigger Status

[Service]
ExecStart={py} {BIN} watch
Environment=PATH={path}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
""")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "muster.service"], check=True, capture_output=True)
    subprocess.run(["systemctl", "--user", "restart", "muster.service"], check=True)
    return "systemd --user muster.service (journalctl --user -u muster)"


def copytree(src: Path, dst: Path) -> None:
    if dst.exists():
        shutil.rmtree(dst)
    shutil.copytree(src, dst)


def install_local() -> None:
    if not shutil.which("hc"):
        sys.exit("muster needs herdr-core's `hc` on PATH: https://herdr.dev/download/")
    SHARE.mkdir(parents=True, exist_ok=True)
    if REPO != SHARE:
        for sub in ("roles", "integrations", "mods", "skill"):
            copytree(REPO / sub, SHARE / sub)
        BIN.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(Path(__file__).resolve(), BIN)
        BIN.chmod(0o755)
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    if not CFG_FILE.exists():
        CFG_FILE.write_text(DEFAULT_CONFIG)
    copytree(SHARE / "integrations" / "omp", CFG_DIR / "omp")
    cfg = config()
    write_templates(cfg)
    for root in spec_roots(cfg):
        root.mkdir(parents=True, exist_ok=True)
    copytree(SHARE / "skill", SKILLS / "muster")
    claude_skills = HOME / ".claude" / "skills"
    if claude_skills.is_dir():  # Claude Code reads ~/.claude/skills, most other agents ~/.agents/skills
        link = claude_skills / "muster"
        if link.is_symlink() or link.exists():
            shutil.rmtree(link) if link.is_dir() and not link.is_symlink() else link.unlink()
        link.symlink_to(SKILLS / "muster")
    mod = ""
    if HERDR_MODS.is_dir():
        copytree(SHARE / "mods" / "muster-pane", HERDR_MODS / "muster-pane")
        mod = f"\n  herdr mod: {HERDR_MODS / 'muster-pane'} (set it as your layout's pane header to see roles)"
    svc = install_service()
    agents = ", ".join(f"{r}={cfg['roles'][r]['command']}" for r in ROLES)
    print(f"muster installed\n  cli: {BIN}\n  config: {CFG_FILE} ({agents})\n  templates: {TEMPLATES}/muster-*.md"
          f"\n  skill: {SKILLS / 'muster'}{mod}\n  watcher: {svc}")


def install_remote(machine: str) -> None:
    dest = ".local/share/muster-src"
    files = [p for p in REPO.rglob("*") if p.is_file() and ".git" not in p.parts]
    for p in files:
        rel = p.relative_to(REPO)
        r = subprocess.run(["hc", "file", "write", "--on", machine, f"{dest}/{rel}"], input=p.read_bytes(), capture_output=True)
        if r.returncode:
            sys.exit(f"copy {rel} to {machine} failed: {r.stderr.decode().strip()}")
    r = subprocess.run(["hc", "exec", "--on", machine, "--", "sh", "-c", f"python3 ~/{dest}/bin/muster install"])
    sys.exit(r.returncode)


def doctor() -> None:
    cfg = config()
    checks = [("hc on PATH", bool(shutil.which("hc"))), ("config", CFG_FILE.is_file())]
    for role in ROLES:
        cmd = cfg["roles"][role]["command"]
        checks.append((f"{role}: `{agent_name(cmd)}` on PATH", bool(shutil.which(agent_name(cmd)))))
        checks.append((f"template muster-{role}", (TEMPLATES / f"muster-{role}.md").is_file()))
    for role in ("tinker", "nitpick"):
        checks.append((f"template muster-pr-{role}", (TEMPLATES / f"muster-pr-{role}.md").is_file()))
    checks.append(("gh on PATH (PR mode)", bool(shutil.which("gh"))))
    for root in spec_roots(cfg):
        checks.append((f"spec root {root}", root.is_dir()))
    if sys.platform == "darwin":
        ok = subprocess.run(["launchctl", "print", f"gui/{os.getuid()}/dev.herdr.muster"], capture_output=True).returncode == 0
    else:
        ok = subprocess.run(["systemctl", "--user", "is-active", "-q", "muster"]).returncode == 0
    checks.append(("watcher running", ok))
    for label, good in checks:
        print(f"{'ok ' if good else 'BAD'}  {label}")
    sys.exit(0 if all(g for _, g in checks) else 1)


def main() -> None:
    a = sys.argv[1:]
    cmd = a[0] if a else ""
    if cmd == "install":
        install_remote(a[a.index("--on") + 1]) if "--on" in a else install_local()
    elif cmd == "doctor":
        doctor()
    elif cmd == "herd" and len(a) == 2:
        print(herd(Path(a[1])))
    elif cmd == "start" and len(a) == 2:
        print(start(Path(a[1])))
    elif cmd == "resume" and len(a) == 2:
        print(resume(Path(a[1])))
    elif cmd == "watch":
        watch()
    elif cmd == "run" and len(a) == 2:
        run(Path(a[1]))
    elif cmd == "pr" and len(a) == 2:
        print(pr_start(a[1]))
    elif cmd == "run-pr" and len(a) == 2:
        run_pr(Path(a[1]))
    else:
        print(__doc__)
        sys.exit(0 if cmd in ("", "-h", "--help") else 2)


if __name__ == "__main__":
    main()
